# Private research inputs and generated artifacts. Only the documentation/templates below are
# versioned; real data and model weights are acquired outside Git.
/data/*
!/data/README.md
!/data/catalog.csv
/results/*
!/results/README.md

# Per-project private data and generated artifacts.
/segmentation/data/*
!/segmentation/data/README.md
!/segmentation/data/manifest_v4.example.csv
/segmentation/runs/
/segmentation/results/
/segmentation/**/patches*/

# Large binary artifacts anywhere in the tree.
*.h5ad
*.geojson
*.tif
*.tiff
*.ndpi
*.pt
*.pth
*.ckpt

# Runtime and editor noise.
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
.env
.venv/
r_libs/
